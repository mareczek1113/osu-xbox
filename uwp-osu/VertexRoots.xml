    <type fullname="osu.Game.Graphics.OpenGL.Vertices.PositionAndColourVertex" preserve="all" />
    <type fullname="osu.Game.Graphics.Sprites.LogoAnimation/LogoAnimationDrawNode/LogoAnimationVertex" preserve="all" />
  </assembly>
</linker>
