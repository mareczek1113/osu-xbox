<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup Label="Project">
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <PropertyGroup Label="Nuget">
    <Title>osu!</Title>
    <PackageId>ppy.osu.Game</PackageId>
    <Version>0.0.0</Version>
    <PackageIcon>icon.png</PackageIcon>
    <IsPackable>true</IsPackable>
  </PropertyGroup>
  <ItemGroup Label="Icon">
    <None Include="..\assets\lazer-nuget.png">
      <Pack>True</Pack>
      <PackagePath>icon.png</PackagePath>
    </None>
  </ItemGroup>
  <ItemGroup Label="Package References">
    <!-- Held back due to licencing change stupidness. Silenced vulnerability does not affect us. -->
    <PackageReference Include="AutoMapper" Version="13.0.1">
      <NoWarn>NU1903</NoWarn>
    </PackageReference>
    <PackageReference Include="DiffPlex" Version="1.9.0"/>
    <PackageReference Include="HtmlAgilityPack" Version="1.13.0"/>
    <PackageReference Include="Humanizer" Version="3.0.10"/>
    <PackageReference Include="MessagePack" Version="3.1.12" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.13"/>
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Protocols.MessagePack" Version="10.0.13"/>
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Protocols.NewtonsoftJson" Version="10.0.13"/>
    <PackageReference Include="Microsoft.Data.Sqlite.Core" Version="10.0.13"/>
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.13"/>
    <PackageReference Include="Microsoft.Toolkit.HighPerformance" Version="7.1.2"/>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4"/>
    <PackageReference Include="ppy.LocalisationAnalyser" Version="2026.611.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Realm" Version="20.1.0"/>
    <!-- Xbox port: the local framework fork instead of the NuGet package (build with -p:XboxPort=true). -->
    <ProjectReference Include="..\..\..\osu-xbox-port\osu-framework\osu.Framework\osu.Framework.csproj" />
    <PackageReference Include="ppy.osu.Framework.SourceGeneration" Version="2025.1121.1" />

    <PackageReference Include="ppy.osu.Game.Resources" Version="2026.1021.0"/>
    <PackageReference Include="Sentry" Version="6.11.0" Condition="'$(XboxPort)' != 'true'" />
    <PackageReference Include="SharpCompress" Version="0.50.4"/>
    <PackageReference Include="NUnit" Version="4.6.1" Condition="'$(XboxPort)' != 'true'" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5"/>
    <PackageReference Include="System.ComponentModel.Annotations" Version="5.0.0"/>
    <PackageReference Include="TagLibSharp" Version="2.3.0"/>
  </ItemGroup>
  <!-- Xbox port: build with -p:XboxPort=true -->
  <PropertyGroup Condition="'$(XboxPort)' == 'true'">
    <DefineConstants>$(DefineConstants);XBOX</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(XboxPort)' == 'true'">
    <Compile Remove="Tests\**" />
    <Compile Remove="Utils\SentryLogger.cs" />
    <Compile Include="Tests\TestChatClientConnector.cs" />
    <Compile Include="Tests\Visual\DependencyProvidingContainer.cs" />
    <Compile Include="Tests\PollingChatClient.cs" />
    <Compile Remove="Overlays\Settings\Sections\Input\TabletSettings.cs" />
    <Compile Remove="Overlays\Settings\Sections\Input\TabletAreaSelection.cs" />
    <Compile Remove="Overlays\Settings\Sections\Input\RotationPresetButtons.cs" />
  </ItemGroup>
</Project>
