<Page
    x:Class="UwpOsu.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="#14142A">
        <!-- Shown from the end of the splash screen until the game draws its first frame: the swap chain panel below is opaque once it presents, so it covers this. -->
        <Image Source="ms-appx:///Assets/LoadingLogo.png" Width="360" Height="360" HorizontalAlignment="Center" VerticalAlignment="Center" />
        <SwapChainPanel x:Name="Panel" />
        <!-- Receives text from the Xbox on-screen keyboard and hardware keyboards while the game wants text. Kept empty; see MainPage.xaml.cs. -->
        <TextBox x:Name="TextSink" Width="1" Height="1" MinWidth="0" MinHeight="0" Opacity="0.01" IsHitTestVisible="False" IsTabStop="False" IsSpellCheckEnabled="False" IsTextPredictionEnabled="False" AcceptsReturn="False" HorizontalAlignment="Left" VerticalAlignment="Bottom" />
        <TextBlock x:Name="Info" Margin="32" FontSize="26" Foreground="White" TextWrapping="Wrap" VerticalAlignment="Top" HorizontalAlignment="Left" />
    </Grid>
</Page>
