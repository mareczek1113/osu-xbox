<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <UseUwp>true</UseUwp>
    <DefaultLanguage>en-US</DefaultLanguage>
    <Platforms>x64</Platforms>
    <Platform>x64</Platform>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>UwpOsu</AssemblyName>
    <RootNamespace>UwpOsu</RootNamespace>
    <PublishAot>true</PublishAot>
    <SelfContained>true</SelfContained>
    <!-- No native debug info: with -g ILC overflows the 2 GB COFF string table when writing the object file. -->
    <NativeDebugSymbols>false</NativeDebugSymbols>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <!-- ILC throws OutOfMemoryException once the single object file passes 2 GB (builds 10/11); fold identical method bodies to shrink it. -->
    <IlcFoldIdenticalMethodBodies>true</IlcFoldIdenticalMethodBodies>
    <!-- Survey build: report every trim/AOT warning at its call site (no NoWarn for IL2xxx/IL3xxx). -->
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <SuppressTrimAnalysisWarnings>false</SuppressTrimAnalysisWarnings>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\osu-aot\osu.Game\osu.Game.csproj" />
    <ProjectReference Include="..\osu-aot\osu.Game.Rulesets.Osu\osu.Game.Rulesets.Osu.csproj" />
    <ProjectReference Include="..\osu-aot\osu.Game.Rulesets.Taiko\osu.Game.Rulesets.Taiko.csproj" />
    <ProjectReference Include="..\osu-aot\osu.Game.Rulesets.Catch\osu.Game.Rulesets.Catch.csproj" />
    <ProjectReference Include="..\osu-aot\osu.Game.Rulesets.Mania\osu.Game.Rulesets.Mania.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- COM wrapper assemblies must survive Native AOT trimming (see XBOX_PORT.md). -->
    <TrimmerRootAssembly Include="SharpGen.Runtime" />
    <TrimmerRootAssembly Include="SharpGen.Runtime.COM" />
    <TrimmerRootAssembly Include="Vortice.DirectX" />
    <TrimmerRootAssembly Include="Vortice.DXGI" />
    <TrimmerRootAssembly Include="Vortice.Direct3D11" />
    <TrimmerRootAssembly Include="Vortice.D3DCompiler" />
    <TrimmerRootAssembly Include="Vortice.XAudio2" />
    <TrimmerRootAssembly Include="Vortice.Mathematics" />
    <TrimmerRootAssembly Include="osu.Framework" />
    <TrimmerRootAssembly Include="ppy.Veldrid" />
    <!-- Realm builds its schema by reflection over the model assemblies (item 9). -->
    <TrimmerRootAssembly Include="Realm" />
    <!-- osu.Game and the built-in rulesets are discovered/instantiated by reflection (item 10a). -->
    <!-- <TrimmerRootAssembly Include="osu.Game" /> (dropped: whole-assembly rooting made ILC run out of memory writing the object file) -->
    <!-- Realm needs its model types kept (schema discovery); root only those, not all of osu.Game. Generated by gen_realm_roots.ps1 -->
    <TrimmerRootDescriptor Include="RealmModels.xml" />
    <!-- Localisation strings are looked up by name (LocalisableDescriptionAttribute); generated by gen_loc_roots.ps1. osu.Game.Resources holds the web strings (mostly string tables). -->
    <TrimmerRootDescriptor Include="LocalisationRoots.xml" />
    <!-- Vertex structs of osu.Game: the renderer reflects over their fields to build input layouts. -->
    <TrimmerRootDescriptor Include="VertexRoots.xml" />
    <TrimmerRootDescriptor Include="ReflectionRoots.xml" />
    <!-- Newtonsoft.Json models (API responses, config); generated by gen_json_roots.ps1 -->
    <TrimmerRootDescriptor Include="JsonModelRoots.xml" />
    <!-- Storyboard sprite/animation/video drawables: VectorScale/FlipH/FlipV are transformed by name from generic code -->
    <TrimmerRootDescriptor Include="StoryboardRoots.xml" />
    <TrimmerRootAssembly Include="osu.Game.Resources" />
    <TrimmerRootAssembly Include="osu.Game.Rulesets.Osu" />
    <TrimmerRootAssembly Include="osu.Game.Rulesets.Taiko" />
    <TrimmerRootAssembly Include="osu.Game.Rulesets.Catch" />
    <TrimmerRootAssembly Include="osu.Game.Rulesets.Mania" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="ppy.osu.Framework.SourceGeneration" Version="2025.1121.1" />
  </ItemGroup>
  <!-- Xbox launch failed with 0x80070002: the AOT exe statically imported VERSION/CRYPT32/IPHLPAPI/ncrypt/WS2_32,
       which the Xbox app environment may not provide. Link these via the UWP umbrella lib (api-set forwarders) instead. -->
  <Target Name="UwpUmbrellaLink" AfterTargets="SetupOSSpecificProps">
    <ReadLinesFromFile File="@(DirectPInvokeList)">
      <Output TaskParameter="Lines" ItemName="_WinApiLine" />
    </ReadLinesFromFile>
    <ItemGroup>
      <_WinApiKept Include="@(_WinApiLine)" Condition="!$([System.String]::new('%(Identity)').StartsWith('version!')) And !$([System.String]::new('%(Identity)').StartsWith('iphlpapi!'))" />
    </ItemGroup>
    <WriteLinesToFile File="$(MSBuildProjectDirectory)\obj\WindowsAPIs.uwp.txt" Lines="@(_WinApiKept)" Overwrite="true" />
    <ItemGroup>
      <DirectPInvokeList Remove="@(DirectPInvokeList)" />
      <DirectPInvokeList Include="$(MSBuildProjectDirectory)\obj\WindowsAPIs.uwp.txt" />
      <LinkerArg Remove="&quot;version.lib&quot;;&quot;crypt32.lib&quot;;&quot;iphlpapi.lib&quot;;&quot;ncrypt.lib&quot;;&quot;ws2_32.lib&quot;" />
      <LinkerArg Include="&quot;WindowsApp.lib&quot;" />
    </ItemGroup>
  </Target>
</Project>
