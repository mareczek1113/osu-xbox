# Whitelist: ignore everything at the top level except the files that make up the port.
/*
!/.gitignore
!/README.md
!/LICENSE
!/docs/
!/uwp-osu/
!/osu-aot/
!/package-uwp.ps1
!/patch_*.ps1
!/gen_*.ps1
!/run-build22.ps1

# Build output and packages, wherever they appear
bin/
obj/
out/
layout/
publish/
aot-publish/
aot-xbox-publish*/
aot-full/out-xbox/
*.appx
*.msix
*.cer
*.pfx

# Logs and temporary output
*.log
*.out.txt
*-out.txt
*-err.txt

# Downloaded installers
dotnet-install.ps1
vs_BuildTools.exe

# Local test data
storage/

# Visual Studio and temporary files
.vs/
*.user
*.suo
